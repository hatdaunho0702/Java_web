<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ===================== PROJECT INFO ===================== -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.4</version>
    <relativePath/>
  </parent>

  <groupId>com.dienmaydemo</groupId>
  <artifactId>dien-may-backend</artifactId>
  <version>1.0.0</version>
  <name>Hệ thống quản lý điện máy</name>
  <description>Backend Spring Boot cho đồ án điện máy</description>

  <properties>
    <java.version>17</java.version>
    <!-- Versions -->
    <lombok.version>1.18.38</lombok.version>
    <firebase-admin.version>9.9.0</firebase-admin.version>
    <modelmapper.version>3.2.4</modelmapper.version>
    <cloudinary.version>1.39.0</cloudinary.version>
    <springdoc.version>2.5.0</springdoc.version>
  </properties>

  <dependencies>

    <!-- ============================================================ -->
    <!-- CORE SPRING BOOT                                             -->
    <!-- ============================================================ -->

    <!-- Web MVC — REST API, Embedded Tomcat -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Data JPA — ORM, Repository pattern -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Spring Security — Auth filter chain, role-based access -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Bean Validation — @NotBlank, @Email, @Min, @Size, ... -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- DevTools — Hot reload khi dev (tắt khi build production) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-devtools</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <!-- ============================================================ -->
    <!-- DATABASE                                                     -->
    <!-- ============================================================ -->

    <!-- SQL Server Connector -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ============================================================ -->
    <!-- FIREBASE                                                     -->
    <!-- ============================================================ -->

    <!-- Firebase Admin SDK — verifyIdToken, quản lý user -->
    <dependency>
      <groupId>com.google.firebase</groupId>
      <artifactId>firebase-admin</artifactId>
      <version>${firebase-admin.version}</version>
    </dependency>

    <!-- ============================================================ -->
    <!-- UTILITIES                                                    -->
    <!-- ============================================================ -->

    <!-- Lombok — @Data, @Builder, @Slf4j, ... -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>${lombok.version}</version>
      <optional>true</optional>
    </dependency>

    <!-- ModelMapper — Entity <-> DTO mapping tự động -->
    <dependency>
      <groupId>org.modelmapper</groupId>
      <artifactId>modelmapper</artifactId>
      <version>${modelmapper.version}</version>
    </dependency>

    <!-- Cloudinary — Upload ảnh lên cloud (thay thế lưu local) -->
    <!-- Bỏ comment nếu muốn dùng Cloudinary thay vì lưu file server -->
    <!--
    <dependency>
      <groupId>com.cloudinary</groupId>
      <artifactId>cloudinary-http44</artifactId>
      <version>${cloudinary.version}</version>
    </dependency>
    -->

    <!-- ============================================================ -->
    <!-- API DOCUMENTATION                                            -->
    <!-- ============================================================ -->

    <!-- Springdoc OpenAPI (Swagger UI) — test API tại /swagger-ui.html -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- ============================================================ -->
    <!-- TESTING                                                      -->
    <!-- ============================================================ -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <!-- ============================================================ -->
  <!-- BUILD                                                        -->
  <!-- ============================================================ -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- Loại bỏ Lombok khỏi JAR cuối -->
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>